# Either a user token (localStorage `userToken` on chat.deepseek.com) or email + password.
# Password login may be blocked by DeepSeek's email verification step; the token avoids it.
DEEPSEEK_TOKEN=
DEEPSEEK_EMAIL=you@example.com
DEEPSEEK_PASSWORD=yourpassword
OPENSEEK_PORT=8888
# Optional: clients must send this as their API key (Bearer token). Set it before exposing the server publicly.
# OPENSEEK_API_KEY=
# Optional: a file whose contents replace the server's default system prompt (an empty file disables it)
# OPENSEEK_SYSTEM_PROMPT_FILE=./system_prompt.txt
# Answer opencode's session-title requests locally instead of using the browser (0 sends them to DeepSeek)
# OPENSEEK_LOCAL_TITLES=1
# Optional: a file that keeps opencode sessions and their DeepSeek chats across restarts
# OPENSEEK_STATE_FILE=./sessions.json
# Optional: time limits in seconds. Raise them for long DeepThink answers and complex coding tasks.
# OPENSEEK_REQUEST_TIMEOUT=120   # whole request: queue, browser steps and generation
# OPENSEEK_TIMEOUT=300           # waiting for DeepSeek's reply
# OPENSEEK_BROWSER_TIMEOUT=20    # each browser command (typing long messages gets extra time)
